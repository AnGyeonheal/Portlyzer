generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  KRW
  USD
}

enum CostMethod {
  FIFO
  AVERAGE
}

enum AssetClass {
  STOCK
  ETF
  CRYPTO
  CUSTOM
}

enum TransactionKind {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  DIVIDEND
  INTEREST
  FEE
  TAX
  FX
  TRANSFER
  SPLIT
  VALUATION
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  CONFIRMED
}

enum DividendStatus {
  ANNOUNCED
  ESTIMATED
}

model User {
  id               String                @id
  name             String
  email            String                @unique
  emailVerified    Boolean               @default(false)
  image            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  baseCurrency     Currency              @default(KRW)
  costMethod       CostMethod            @default(FIFO)
  benchmarkAssetId String?
  isDemo           Boolean               @default(false)
  ledgerVersion    Int                   @default(0)
  sessions         Session[]
  authAccounts     Account[]
  portfolios       Portfolio[]
  brokerAccounts   BrokerAccount[]
  assets           Asset[]
  originals        OriginalTransaction[]
  transactions     Transaction[]
  revisions        TransactionRevision[]
  journalEntries   JournalEntry[]
  importJobs       ImportJob[]
  prices           Price[]
  fxRates          FxRate[]
  dividends        DividendEvent[]
  corporateActions CorporateAction[]
  goals            InvestmentGoal[]
  targets          AllocationTarget[]
  providerJobs     ProviderJob[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model ApiRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Portfolio {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts  BrokerAccount[]

  @@unique([userId, name])
  @@index([userId])
}

model BrokerAccount {
  id           String         @id @default(cuid())
  userId       String
  portfolioId  String?
  name         String
  institution  String         @default("")
  accountType  String         @default("GENERAL")
  currency     Currency       @default(KRW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?     @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  transactions Transaction[]  @relation("SourceAccount")
  incoming     Transaction[]  @relation("TargetAccount")
  imports      ImportJob[]
  entries      JournalEntry[]

  @@index([userId])
}

model Asset {
  id           String            @id @default(cuid())
  userId       String
  symbol       String
  name         String
  exchange     String
  currency     Currency
  assetClass   AssetClass
  country      String?
  sector       String?
  provider     String            @default("MANUAL")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  prices       Price[]
  dividends    DividendEvent[]
  actions      CorporateAction[]

  @@unique([userId, symbol, exchange])
  @@index([userId])
}

model OriginalTransaction {
  id                  String       @id @default(cuid())
  userId              String
  source              String
  sourceKey           String
  sourceTransactionId String?
  importJobId         String?
  rowNumber           Int?
  rawData             Json
  createdAt           DateTime     @default(now())
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJob           ImportJob?   @relation(fields: [importJobId], references: [id])
  transaction         Transaction?

  @@unique([userId, sourceKey])
  @@index([userId])
}

model Transaction {
  id              String                @id @default(cuid())
  userId          String
  accountId       String
  originalId      String                @unique
  date            DateTime              @db.Date
  sequence        Int                   @default(autoincrement())
  kind            TransactionKind
  currency        Currency
  assetId         String?
  quantity        Decimal?              @db.Decimal(30, 12)
  price           Decimal?              @db.Decimal(30, 12)
  amount          Decimal?              @db.Decimal(30, 12)
  fee             Decimal               @default(0) @db.Decimal(30, 12)
  tax             Decimal               @default(0) @db.Decimal(30, 12)
  toAccountId     String?
  toCurrency      Currency?
  toAmount        Decimal?              @db.Decimal(30, 12)
  ratio           Decimal?              @db.Decimal(30, 12)
  memo            String                @default("")
  tags            String[]              @default([])
  dividendEventId String?
  revision        Int                   @default(1)
  requestId       String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         BrokerAccount         @relation("SourceAccount", fields: [accountId], references: [id])
  toAccount       BrokerAccount?        @relation("TargetAccount", fields: [toAccountId], references: [id])
  asset           Asset?                @relation(fields: [assetId], references: [id])
  original        OriginalTransaction   @relation(fields: [originalId], references: [id])
  dividendEvent   DividendEvent?        @relation(fields: [dividendEventId], references: [id])
  revisions       TransactionRevision[]
  entries         JournalEntry[]
  corporateAction CorporateAction?

  @@unique([userId, requestId])
  @@index([userId, date, sequence])
}

model TransactionRevision {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  version       Int
  operation     String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, version])
  @@index([userId])
}

model JournalEntry {
  id            String        @id @default(cuid())
  userId        String
  transactionId String
  accountId     String
  line          Int
  date          DateTime      @db.Date
  currency      Currency
  assetId       String?
  quantity      Decimal?      @db.Decimal(30, 12)
  amount        Decimal       @db.Decimal(30, 12)
  category      String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  account       BrokerAccount @relation(fields: [accountId], references: [id])

  @@unique([transactionId, line])
  @@index([userId, date])
}

model ImportJob {
  id          String                @id @default(cuid())
  userId      String
  accountId   String
  filename    String
  fileHash    String
  format      String
  status      ImportStatus          @default(UPLOADED)
  headers     Json
  rows        Json
  mapping     Json?
  validated   Json?
  revision    Int                   @default(1)
  confirmedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     BrokerAccount         @relation(fields: [accountId], references: [id])
  originals   OriginalTransaction[]

  @@unique([userId, accountId, fileHash])
  @@index([userId])
}

model Price {
  id         String   @id @default(cuid())
  userId     String
  assetId    String
  date       DateTime @db.Date
  close      Decimal  @db.Decimal(30, 12)
  currency   Currency
  adjustment String   @default("RAW")
  source     String
  fetchedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId, date, source])
  @@index([userId, date])
}

model FxRate {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  base      Currency
  quote     Currency
  rate      Decimal  @db.Decimal(30, 12)
  source    String
  fetchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, base, quote, source])
  @@index([userId, date])
}

model DividendEvent {
  id             String         @id @default(cuid())
  userId         String
  assetId        String
  status         DividendStatus
  exDate         DateTime?      @db.Date
  recordDate     DateTime?      @db.Date
  payDate        DateTime?      @db.Date
  amountPerShare Decimal        @db.Decimal(30, 12)
  currency       Currency
  source         String
  basis          String
  asOf           DateTime       @db.Date
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  receipts       Transaction[]

  @@index([userId, payDate])
}

model CorporateAction {
  id            String      @id @default(cuid())
  userId        String
  assetId       String
  transactionId String      @unique
  date          DateTime    @db.Date
  kind          String
  ratio         Decimal     @db.Decimal(30, 12)
  source        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         Asset       @relation(fields: [assetId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([userId])
}

model InvestmentGoal {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  kind                String
  target              Decimal  @db.Decimal(30, 12)
  currency            Currency
  initial             Decimal  @db.Decimal(30, 12)
  monthlyContribution Decimal  @db.Decimal(30, 12)
  annualReturn        Decimal  @db.Decimal(12, 8)
  years               Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AllocationTarget {
  id        String  @id @default(cuid())
  userId    String
  dimension String
  key       String
  percent   Decimal @db.Decimal(8, 4)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dimension, key])
}

model ProviderJob {
  id         String    @id @default(cuid())
  userId     String
  provider   String
  status     String
  requestKey String    @unique
  from       DateTime  @db.Date
  to         DateTime  @db.Date
  count      Int       @default(0)
  errorCode  String?
  message    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
