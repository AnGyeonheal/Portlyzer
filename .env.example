DATABASE_URL="postgresql://portlyzer:local-development-only@localhost:5432/portlyzer?schema=public"
POSTGRES_PASSWORD="local-development-only"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
ALPHA_VANTAGE_API_KEY=""
ALPHA_VANTAGE_LICENSE_ACK="false"
# Demo records are ONLY created in a separately registered demo user.
ENABLE_DEMO="true"
NEXT_TELEMETRY_DISABLED="1"
APP_MODE="local"
# Public mode requires HTTPS, PostgreSQL TLS, SMTP and verified email.
MAIL_ENABLED="false"
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional: supply an independent backup passphrase (32+ characters).
# Otherwise db:backup creates .local-state/backup.key; store it offline separately.
BACKUP_PASSPHRASE=""
